{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NestJS (ts-node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/ts-node/dist/bin.js",
      "args": [
        "-r",
        "tsconfig-paths/register",
        "--transpile-only",
        "${workspaceFolder}/src/main.ts"
      ],
      "env": {
        "NODE_ENV": "development",
      },
      "runtimeArgs": [
        "--nolazy"
      ],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "${workspaceFolder}/node_modules/**/*.js",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug NestJS (watch mode)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": [
        "start",
        "--watch",
        "--preserveWatchOutput",
        "--debug"
      ],
      "env": {
        "NODE_ENV": "development",
        "TS_NODE_TRANSPILE_ONLY": "false"
      },
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "${workspaceFolder}/node_modules/**/*.js",
        "<node_internals>/**"
      ]
    },
  ]
}